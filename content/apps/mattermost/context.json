{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "preferences": [
    "server_port",
    "site_url",
    "default_team",
    "file_storage"
  ],
  "secrets": [
    {
      "key": "MM_SQLSETTINGS_DATASOURCE",
      "reference": "secret://mm/sqlsettings-datasource"
    },
    {
      "key": "MM_SERVICESETTINGS_SITEURL",
      "reference": "secret://mm/servicesettings-siteurl"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in"
  ]
}
