{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "preferences": [
    "ollama_base_url",
    "webui_port",
    "default_models"
  ],
  "secrets": [
    {
      "key": "OPENAI_API_KEY",
      "reference": "secret://openai/api-key"
    },
    {
      "key": "WEBUI_SECRET_KEY",
      "reference": "secret://webui/secret-key"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in"
  ]
}
