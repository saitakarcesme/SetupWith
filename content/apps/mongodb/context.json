{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "preferences": [
    "mongo_user",
    "mongo_database",
    "mongo_port",
    "data_directory"
  ],
  "secrets": [
    {
      "key": "MONGO_INITDB_ROOT_PASSWORD",
      "reference": "secret://mongo/initdb-root-password"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in"
  ]
}
