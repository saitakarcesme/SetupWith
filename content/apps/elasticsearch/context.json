{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "preferences": [
    "cluster_name",
    "http_port",
    "data_directory",
    "heap_size"
  ],
  "secrets": [
    {
      "key": "ELASTIC_PASSWORD",
      "reference": "secret://elastic/password"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in"
  ]
}
