{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "preferences": [
    "domain_name",
    "server_port",
    "database_name",
    "file_storage"
  ],
  "secrets": [
    {
      "key": "SECRET_KEY",
      "reference": "secret://secret/key"
    },
    {
      "key": "POSTGRES_PASSWORD",
      "reference": "secret://postgres/password"
    },
    {
      "key": "AWS_SECRET_ACCESS_KEY",
      "reference": "secret://aws/secret-access-key"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in"
  ]
}
