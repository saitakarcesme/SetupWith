{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "preferences": [
    "domain_name",
    "database_provider",
    "server_port"
  ],
  "secrets": [
    {
      "key": "GLOBALSETTINGS_IDENTITYSERVER_CERTIFICATEPASSWORD",
      "reference": "secret://globalsettings/identityserver-certificatepassword"
    },
    {
      "key": "GLOBALSETTINGS_SQLSERVER_SA_PASSWORD",
      "reference": "secret://globalsettings/sqlserver-sa-password"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in"
  ]
}
