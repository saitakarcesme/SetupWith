{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "10–20 min",
  "complexity": "Advanced",
  "preferences": [
    "data_root",
    "default_registry",
    "log_driver",
    "storage_driver"
  ],
  "secrets": [
    {
      "key": "DOCKER_AUTH_CONFIG",
      "reference": "secret://docker/auth-config"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in"
  ]
}
