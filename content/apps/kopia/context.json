{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "10–20 min",
  "complexity": "Advanced",
  "delivery": "native",
  "safety": {
    "requiresSignIn": false,
    "requiresElevation": false,
    "mayInstallDrivers": false,
    "mayInstallKernelComponents": false,
    "mayRequireRestart": false
  },
  "preferences": [
    "install_variant",
    "repository_provider",
    "snapshot_policy",
    "retention_policy"
  ],
  "secrets": [
    {
      "key": "KOPIA_PASSWORD",
      "reference": "secret://kopia/password"
    }
  ],
  "permissionCheckpoints": [
    "CLI versus KopiaUI installation",
    "repository creation or connection",
    "repository password generation and backup",
    "cloud or network credential access",
    "snapshot source selection",
    "schedule and retention policy activation",
    "maintenance and content deletion",
    "restore destination overwrite"
  ]
}
