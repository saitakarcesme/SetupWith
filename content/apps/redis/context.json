{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "preferences": [
    "redis_port",
    "maxmemory",
    "persistence_mode",
    "data_directory"
  ],
  "secrets": [
    {
      "key": "REDIS_PASSWORD",
      "reference": "secret://redis/password"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in"
  ]
}
