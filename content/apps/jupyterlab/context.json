{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "preferences": [
    "workspace_dir",
    "server_port",
    "default_kernel"
  ],
  "secrets": [
    {
      "key": "JUPYTER_TOKEN",
      "reference": "secret://jupyter/token"
    }
