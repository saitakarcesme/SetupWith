{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "preferences": [
    "bun_version",
    "npm_registry",
    "install_cache_dir"
  ],
  "secrets": [
    {
      "key": "NPM_TOKEN",
      "reference": "secret://npm/token"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in"
  ]
}
