{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "preferences": [
    "cache_directory",
    "severity_threshold",
    "ignore_unfixed",
    "output_format"
  ],
  "secrets": [
    {
      "key": "GITHUB_TOKEN",
      "reference": "secret://github/token"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in"
  ]
}
