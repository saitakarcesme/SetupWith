    "virtual machine creation",
    "container runtime selection",
    "CPU, memory, and disk allocation",
    "host directory mounts",
    "port forwarding",
    "Kubernetes enablement",
    "Docker or kubectl context changes",
    "large image and model downloads"
  ]
}
