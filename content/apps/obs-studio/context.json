{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "preferences": [
    "recording_path",
    "video_resolution",
    "video_fps",
    "hardware_encoder"
  ],
  "secrets": [
    {
      "key": "TWITCH_STREAM_KEY",
      "reference": "secret://twitch/stream-key"
    },
    {
      "key": "YOUTUBE_STREAM_KEY",
      "reference": "secret://youtube/stream-key"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in"
  ]
}
