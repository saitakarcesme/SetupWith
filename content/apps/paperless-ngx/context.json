{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "delivery": "package-manager",
  "safety": {
    "requiresSignIn": false,
    "requiresElevation": false,
    "mayInstallDrivers": false,
    "mayInstallKernelComponents": false,
    "mayRequireRestart": false
  },
  "preferences": [
    "consume_directory",
    "media_root",
    "server_port",
    "ocr_language"
  ],
  "secrets": [
    {
      "key": "PAPERLESS_SECRET_KEY",
      "reference": "secret://paperless/secret-key"
    },
    {
      "key": "PAPERLESS_DBPASS",
      "reference": "secret://paperless/dbpass"
    },
    {
      "key": "PAPERLESS_ADMIN_PASSWORD",
      "reference": "secret://paperless/admin-password"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in",
    "account creation, MFA, CAPTCHA, age verification, or paid subscription",
    "large downloads and destination storage",
    "drivers, anti-cheat, kernel components, or restart"
  ]
}
