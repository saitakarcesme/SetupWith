{
  "platforms": [
    "macOS",
    "Linux",
    "Windows"
  ],
  "installTime": "5–10 min",
  "complexity": "Guided",
  "preferences": [
    "public_url",
    "server_port",
    "default_timezone"
  ],
  "secrets": [
    {
      "key": "NEXTAUTH_SECRET",
      "reference": "secret://nextauth/secret"
    },
    {
      "key": "CALENDSO_ENCRYPTION_KEY",
      "reference": "secret://calendso/encryption-key"
    },
    {
      "key": "DATABASE_URL",
      "reference": "secret://database/url"
    }
  ],
  "permissionCheckpoints": [
    "administrator access",
    "configuration overwrite",
    "service or daemon changes",
    "ports and firewall rules",
    "browser sign-in"
  ]
}
